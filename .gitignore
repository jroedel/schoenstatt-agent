# Credentials — never commit. See CLAUDE.md.
.env
.env.*
!.env.dist
*.jwt
*.pem
*.key
secrets/

# Database dumps
*.sql
*.sql.gz
*.dump

# Compiled binaries.
#
# Anchored with a leading slash, and it must stay that way. An unanchored
# `schoenstatt-mcp` matches at any depth, so it ignored the whole of
# `cmd/schoenstatt-mcp/` — source, README and all — which in a repository that is
# going to be published means shipping without the MCP server this file documents.
# `go build ./cmd/schoenstatt-mcp` writes the binary to the repository root, so the
# root is the only place the pattern needs to match.
/bin/
/schoenstatt-mcp

# Local scratch
tmp/
.cache/
*.log
__pycache__/
*.pyc

# Editors and OS
.idea/
.vscode/
.DS_Store
*.swp
